{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActivityStreams 2.0 Article",
  "description": "Edustaa uutisartikkelia, blogipostausta tai muuta itsenäistä tekstituotetta.",
  "type": "object",
  "properties": {
    "@context": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "type": "object" }
            ]
          }
        }
      ],
      "description": "JSON-LD konteksti, tyypillisesti https://www.w3.org/ns/activitystreams ja uutisseuranta-nimiavaruuslaajennus"
    },
    "type": {
      "type": "string",
      "description": "Objektin tyyppi, arvon on oltava 'Article'"
    },
    "id": {
      "type": "string",
      "description": "Objektin yksikäsitteinen pysyvä tunniste (persistent IRI: https://uutisseuranta.net/ap/objects/{hash})"
    },
    "name": {
      "type": "string",
      "description": "Artikkelin otsikko tai nimi"
    },
    "summary": {
      "type": "string",
      "description": "Artikkelin yhteenveto tai lyhyt katkelma"
    },
    "content": {
      "type": "string",
      "description": "Artikkelin HTML-muotoiltu pääsisältö"
    },
    "url": {
      "type": "string",
      "description": "Alkuperäisen artikkelin verkko-osoite (URL)"
    },
    "published": {
      "type": "string",
      "description": "Julkaisuajankohta RFC 3339 -muodossa"
    },
    "updated": {
      "type": "string",
      "description": "Viimeisin päivitysajankohta RFC 3339 -muodossa"
    },
    "attributedTo": {
      "type": "string",
      "description": "Artikkelin tekijä tai julkaisija (esim. uutislähteen nimi)"
    },
    "likes": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Collection"] },
        "totalItems": { "type": "integer" }
      },
      "required": ["type", "totalItems"],
      "description": "Artikkelin tykkäysten kokoelma (AS2 Core §5.7)"
    },
    "dislikes": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Collection"] },
        "totalItems": { "type": "integer" }
      },
      "required": ["type", "totalItems"],
      "description": "Artikkelin dislike-reaktioiden kokoelma (projektikohtainen laajennus)"
    },
    "_uutisseuranta:agreeCount": {
      "type": "integer",
      "description": "Yhteenlaskettu reaktiomäärä (likes + dislikes) (projektikohtainen laajennus)"
    },
    "tag": {
      "type": "array",
      "items": {
        "$ref": "hashtag.schema.json"
      },
      "description": "Artikkeliin liittyvät AS2 Hashtag-objektit (Voikko-jobin tuottamat morfologiset tagit)"
    }
  },
  "required": ["@context", "type", "id", "name", "url", "published"]
}
