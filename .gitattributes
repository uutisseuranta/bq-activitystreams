# Enforce LF line endings for text files
* text=auto eol=lf

# Explicitly LF for CSV and scripts
*.csv text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tf text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.ico binary
